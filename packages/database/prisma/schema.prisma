generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EVALUATOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum TestStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum QuestionType {
  SINGLE_SELECT
  MULTI_SELECT
  RATING
  RANKING
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  TEXT
}

enum MediaSourceType {
  UPLOAD
  GOOGLE_DRIVE
}

enum PushPlatform {
  IOS
  ANDROID
  WEB
}

enum NotificationKind {
  TEST_ACTIVATED
  REMINDER
}

enum NotificationStatus {
  PENDING
  /// Claimed by a dispatch worker (SELECT ... FOR UPDATE SKIP LOCKED) but not yet resolved.
  /// A distinct state from PENDING so the claiming transaction can commit - releasing the
  /// row lock - the instant it claims a batch, without another worker re-selecting the same
  /// rows before the actual send finishes (see notification.service.ts's dispatch loop).
  PROCESSING
  SENT
  FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  role         UserRole @default(EVALUATOR)
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // KVKK: the Article 10 disclosure (aydinlatma) and any explicit consent
  // (acik riza) are deliberately two separate timestamps. Kurul Ilke Karari
  // 2026/347 prohibits collecting them as a single merged action, so they must
  // never be set from one checkbox. Null means the step was not taken; mobile
  // registration blocks on the first, and does not block on the second.
  aydinlatmaAcknowledgedAt DateTime?
  acikRizaAcceptedAt       DateTime?

  /// Index into the avatar presets bundled with the mobile app. There is no
  /// upload endpoint and no photo storage by design - this records a choice,
  /// not an image, which keeps avatars out of KVKK's biometric/photo scope.
  avatarId Int?

  /// Device the account was registered from, when it registered through the
  /// mobile app. Used only to notice one device creating several accounts in a
  /// points economy. Deliberately not unique: shared and family devices are
  /// legitimate, so a repeat is flagged for review rather than blocked.
  registrationDeviceId String?
  /// Set when registrationDeviceId already belonged to another account. This
  /// lives on User rather than EvaluatorProfile (as the plan sketched) because
  /// it is decided at registration, before any profile row exists.
  isDeviceFlagged      Boolean @default(false)

  evaluatorProfile  EvaluatorProfile?
  responses         TestResponse[]
  mobileAuthCodes   MobileAuthCode[]
  pushSubscriptions PushSubscription[]
  notificationLogs  NotificationLog[]

  @@index([role])
  @@index([registrationDeviceId])
}

/// One-time code bridging the Google OAuth redirect back into the mobile app.
/// The app cannot receive cookies, and putting tokens in the deep-link URL
/// would leak them into OS logs and browser history, so the callback hands over
/// a short-lived single-use code that is exchanged for the token pair instead.
model MobileAuthCode {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@index([userId])
}

model EvaluatorProfile {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  age              Int
  gender           Gender
  country          String
  city             String?
  nativeLanguage   String?
  foreignLanguages String[] @default([])
  occupation       String?
  educationLevel   String?
  aiUseCases       String[] @default([])
  aiExperience     String?
  aiFrequency      String?
  hobbies          String[] @default([])
  balance          Int      @default(0)
  /// Bumped on every submitted response (and at profile creation) - 21.1's re-engagement
  /// reminder reads this to find evaluators who have gone quiet, without a separate scan
  /// over TestResponse for each one's most recent submission.
  lastActivityAt   DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Test {
  id                 String         @id @default(uuid()) @db.Uuid
  title              String
  description        String?
  status             TestStatus     @default(DRAFT)
  responseCap        Int?
  advisoryTimeMin    Float?
  minTimePerQuestion Int            @default(60)
  demographicFilters Json?
  rewardPoints       Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  questions          Question[]
  responses          TestResponse[]
  notificationLogs   NotificationLog[]

  // Replaces the old standalone [status] index — [status, createdAt] is a strict
  // superset (leftmost-prefix), matching /next-test's `WHERE status = 'ACTIVE' ORDER BY
  // createdAt ASC` exactly.
  @@index([status, createdAt])
}

model Question {
  id               String           @id @default(uuid()) @db.Uuid
  testId           String           @db.Uuid
  test             Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  type             QuestionType
  prompt           String
  mediaType        MediaType?
  /// The media the question is *about* — the image being rated, the clip being ranked.
  /// Shown above the answer UI; unlike a QuestionOption it is never selectable.
  mediaId          String?          @db.Uuid
  media            Media?           @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  order            Int
  config           Json             @default("{}")
  isAttentionCheck Boolean          @default(false)
  isTrapDuplicate  Boolean          @default(false)
  trapSourceId     String?          @db.Uuid
  trapSource       Question?        @relation("QuestionTrap", fields: [trapSourceId], references: [id])
  trapDuplicates   Question[]       @relation("QuestionTrap")
  createdAt        DateTime         @default(now())
  options          QuestionOption[]
  answers          Answer[]

  @@unique([testId, order])
  @@index([testId, order])
  @@index([mediaId])
  @@index([trapSourceId])
}

model QuestionOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String?
  mediaId    String?  @db.Uuid
  media      Media?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  order      Int

  @@unique([questionId, order])
  @@index([questionId])
  @@index([mediaId])
}

model Media {
  id          String            @id @default(uuid()) @db.Uuid
  fileName    String
  fileType    MediaType
  mimeType    String
  fileSize    Int
  sourceType  MediaSourceType
  sourceUrl   String?
  thumbnailUrl String?
  tags        String[]          @default([])
  uploadedAt  DateTime          @default(now())
  options     QuestionOption[]
  questions   Question[]

  @@index([fileType])
  // drive.service.ts's importFolder() does a per-file de-dupe lookup on this column for
  // every file in a Drive folder import — unindexed, that's a full scan per file.
  @@index([sourceUrl])
}

model TestResponse {
  id               String   @id @default(uuid()) @db.Uuid
  testId           String   @db.Uuid
  test             Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isFlagged        Boolean  @default(false)
  flagReasons      String[] @default([])
  pointsEarned     Int      @default(0)
  startedAt        DateTime
  completedAt      DateTime
  totalTimeSeconds Int
  answers          Answer[]

  @@unique([testId, userId])
  @@index([testId])
  @@index([userId])
}

model Answer {
  id               String       @id @default(uuid()) @db.Uuid
  responseId       String       @db.Uuid
  response         TestResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId       String       @db.Uuid
  question         Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// Selected option IDs. For ORDERING questions this is the evaluator's ranking: a full
  /// permutation of the question's options, best-first — the array order carries the answer.
  selectedOptions  String[]     @default([]) @db.Uuid
  ratingValue      Int?
  timeSpentSeconds Int

  @@unique([responseId, questionId])
  @@index([questionId])
}

/// Rewards catalog item (prd.md §11.2a / §12.4). Browsing only in v1 - redemption/purchase
/// (balance deduction, fulfillment) is explicitly out of scope, see plan.md's Future/Backlog.
model Coupon {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  imageUrl     String?
  pointsCost   Int
  isActive     Boolean  @default(true)
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
}

model Template {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  structure   Json
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// One push destination for one device/browser (21.2). `token` is an Expo push token for
/// IOS/ANDROID or a JSON-stringified Web Push subscription (endpoint + keys) for WEB - unique
/// on its own because it identifies the destination regardless of which account currently
/// owns it, so re-registering the same device under a different account moves it rather than
/// creating a duplicate row the old account would still receive sends for.
model PushSubscription {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   PushPlatform
  token      String       @unique
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime     @default(now())

  @@index([userId])
}

/// One row per (user, notification) send, doubling as the dedup ledger 21.1 calls for. The
/// unique constraint is on `(userId, kind, dedupeKey)` rather than `(userId, kind, testId)`
/// because REMINDER rows carry no testId - Postgres treats NULLs as distinct in a unique
/// index, so two reminders with testId null would never collide. `dedupeKey` is the testId
/// for TEST_ACTIVATED and a reminder-window bucket (e.g. an ISO date) for REMINDER, so both
/// kinds get a real de-dup key either way.
model NotificationLog {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  dedupeKey String
  testId    String?            @db.Uuid
  test      Test?              @relation(fields: [testId], references: [id], onDelete: Cascade)
  status    NotificationStatus @default(PENDING)
  title     String
  body      String
  data      Json?
  attempts  Int                @default(0)
  lastError String?
  createdAt DateTime           @default(now())
  sentAt    DateTime?

  @@unique([userId, kind, dedupeKey])
  @@index([status, createdAt])
  @@index([userId])
}
