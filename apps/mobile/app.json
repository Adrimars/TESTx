{
  "expo": {
    "name": "TESTx",
    "slug": "testx",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "testx",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.testx.app"
    },
    "android": {
      "package": "com.testx.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
