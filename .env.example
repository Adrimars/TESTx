# Add `&connection_limit=<n>&pool_timeout=<seconds>` before running more than one API
# instance against this database (e.g. "...?schema=public&connection_limit=10") — Prisma's
# unconfigured default pool size is `num_physical_cpus * 2 + 1` *per process*, and N
# instances with no explicit limit can collectively exceed Postgres's `max_connections`.
# For real horizontal scaling, prefer a pooler in front of Postgres (PgBouncer in
# transaction mode, or a managed pooler like Neon/Supabase's) over a bare connection_limit.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/testx?schema=public"
API_HOST="0.0.0.0"
API_PORT="4000"
EVALUATOR_APP_URL="http://localhost:3000"
ADMIN_APP_URL="http://localhost:3001"
# The origin a *browser* sees the mobile-web build on: it is allowed through CORS and is
# where Google sign-in returns to (auth.ts's "mobile-web" callback branch). On a
# same-domain deployment that is EVALUATOR_APP_URL, since apps/evaluator's proxy.ts is
# what serves mobile-web there — not the upstream that proxy.ts fetches from, which is
# its own MOBILE_WEB_PROXY_TARGET in apps/evaluator/.env. Both default to the Expo dev
# server, so dev needs neither.
MOBILE_WEB_URL="http://localhost:8081"
NEXT_PUBLIC_API_URL="http://localhost:4000"
UPLOAD_DIR="./uploads"
CACHE_DIR="./cache/media"
CACHE_MAX_SIZE_MB="2048"
# Shared rate-limit store. Required before running more than one API instance — unset,
# rate limiting falls back to a per-process in-memory store (see plugins/rate-limit.ts).
REDIS_URL=""
GOOGLE_DRIVE_API_KEY=""
